.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Python caches and tooling artifacts
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.hatch/
.pre-commit-cache/
.coverage
coverage.xml
htmlcov/

# Secrets / local env (never commit tokens)
.env
.env.*
!.env.example

# Temporary files
*.log
*.tmp
*.swp

# Local-only data (large / machine-specific; not committed)
raw/**
state/medium_to_readwise/**
state/readwise_library.json
state/review_feedback.sqlite

# Obsidian local vault state
.obsidian/**

# Local agent/app runtime state
.agents/**
