						<string>const READWISE_TOKEN = "￼".trim();

if (!READWISE_TOKEN || READWISE_TOKEN === "PASTE_READWISE_TOKEN") {
  completion("Readwise-Token fehlt. Öffne den Kurzbefehl und trage ihn in der ersten Text-Aktion ein.");
} else {
  const canonical = document.querySelector('link[rel="canonical"]')?.href || location.href;
  const payload = {
    url: canonical,
    title: document.title,
    html: document.documentElement.outerHTML,
    should_clean_html: true,
    category: "article",
    location: "new",
    saved_using: "iOS Safari Full HTML"
  };

  fetch("https://readwise.io/api/v3/save/", {
    method: "POST",
    headers: {
      "Authorization": `Token ${READWISE_TOKEN}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  })
  .then(async response =&gt; {
    const text = await response.text();
    if (!response.ok) {
      completion(`Readwise-Fehler ${response.status}: ${text}`);
      return;
    }
    completion("Artikel vollständig in Readwise gespeichert.");
  })
  .catch(error =&gt; completion(`Übertragung fehlgeschlagen: ${error.message}`));
}</string>
