# Server-side production env example for llm-wiki-api.
# Copy to deploy/llm-wiki.env (Compose default env_file) and keep it untracked.
# On the server that is usually /srv/llm-wiki/app/deploy/llm-wiki.env.
# Do not put Basic Auth credentials here.
# Never run `docker compose ... config` without `-q` when this file has real secrets.

LLM_WIKI_PATHS_CONFIG=/app/config/wiki_paths.server.toml
OPENAI_API_KEY=
READWISE_TOKEN=
PYTHONUNBUFFERED=1
